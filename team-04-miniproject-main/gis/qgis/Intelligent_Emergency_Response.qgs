<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Intelligent Emergency Response System (IERS) - Hubballi-Dharwad Metropolitan Region" version="3.44.15">
  <homePath path=""/>
  <title>IERS Metropolitan PostGIS Demonstration (Hubballi-Dharwad)</title>
  <autotransactors>1</autotransactors>
  <dates>
    <created>2026-11-21T15:00:00</created>
  </dates>
  <mapcanvas name="theMapCanvas">
    <units>degrees</units>
    <extent>
      <xmin>74.9135</xmin>
      <ymin>15.2093</ymin>
      <xmax>75.3113</xmax>
      <ymax>15.6164</ymax>
    </extent>
    <rotation>0</rotation>
    <destinationsrs>
      <spatialrefsys>
        <wkt>GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563,LENGTHUNIT["metre",1]]],PRIMEM["Greenwich",0,ANGLEUNIT["degree",0.0174532925199433]],CS[ellipsoidal,2],AXIS["geodetic latitude (Lat)",north,ORDER[1],ANGLEUNIT["degree",0.0174532925199433]],AXIS["geodetic longitude (Lon)",east,ORDER[2],ANGLEUNIT["degree",0.0174532925199433]],ID["EPSG",4326]]</wkt>
        <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
        <srsid>3452</srsid>
        <srid>4326</srid>
        <authid>EPSG:4326</authid>
        <description>WGS 84</description>
        <projectionacronym>longlat</projectionacronym>
        <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
        <geographicflag>true</geographicflag>
      </spatialrefsys>
    </destinationsrs>
  </mapcanvas>
  <projectlayers>

    <!-- LAYER 1: Metropolitan Hospital Coverage Buffers (2.5 km service zone) -->
    <maplayer autoRefreshTime="0" hasScaleBasedVisibilityFlag="0" id="iers_hosp_coverage_metro" maxScale="0" minScale="1e+08" refreshOnNotifyEnabled="0" type="vector">
      <id>iers_hosp_coverage_metro</id>
      <datasource>dbname='iers_db' host=localhost port=5434 user='iers_user' password='iers_dev_local' sslmode=disable key='hospital_id' srid=4326 type=Polygon table="iers"."v_hospital_coverage_metropolitan" (coverage_geom) sql=</datasource>
      <layername>1. Hospital 2.5km Service Buffers (PostGIS View)</layername>
      <srs>
        <spatialrefsys><srid>4326</srid><authid>EPSG:4326</authid></spatialrefsys>
      </srs>
      <renderer-v2 type="singleSymbol">
        <symbols>
          <symbol alpha="0.15" clip_to_extent="1" force_rhr="0" name="0" type="fill">
            <layer class="SimpleFill" locked="0" pass="0">
              <prop k="color" v="239,68,68,40"/>
              <prop k="outline_color" v="239,68,68,180"/>
              <prop k="outline_width" v="0.6"/>
              <prop k="outline_style" v="dash"/>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- LAYER 2: Complete Metropolitan Road Network (40,394 Segments) -->
    <maplayer autoRefreshTime="0" hasScaleBasedVisibilityFlag="0" id="iers_metropolitan_roads" maxScale="0" minScale="1e+08" refreshOnNotifyEnabled="0" type="vector">
      <id>iers_metropolitan_roads</id>
      <datasource>dbname='iers_db' host=localhost port=5434 user='iers_user' password='iers_dev_local' sslmode=disable key='road_id' srid=4326 type=LineString table="iers"."roads" (geom) sql=</datasource>
      <layername>2. Metropolitan Road Network (40,394 Edges - PostGIS)</layername>
      <srs>
        <spatialrefsys><srid>4326</srid><authid>EPSG:4326</authid></spatialrefsys>
      </srs>
      <renderer-v2 type="categorizedSymbol" attr="highway">
        <categories>
          <category value="trunk" label="Trunk Highway (Connecting Corridor)" symbol="trunk_sym"/>
          <category value="primary" label="Primary Arterial" symbol="prim_sym"/>
          <category value="secondary" label="Secondary Arterial" symbol="sec_sym"/>
          <category value="tertiary" label="Tertiary Street" symbol="tert_sym"/>
          <category value="residential" label="Residential &amp; Local Streets" symbol="res_sym"/>
        </categories>
        <symbols>
          <symbol alpha="1" clip_to_extent="1" force_rhr="0" name="trunk_sym" type="line">
            <layer class="SimpleLine" locked="0" pass="3">
              <prop k="line_color" v="234,88,12,255"/>
              <prop k="line_width" v="1.6"/>
              <prop k="line_style" v="solid"/>
            </layer>
          </symbol>
          <symbol alpha="1" clip_to_extent="1" force_rhr="0" name="prim_sym" type="line">
            <layer class="SimpleLine" locked="0" pass="2">
              <prop k="line_color" v="245,158,11,255"/>
              <prop k="line_width" v="1.2"/>
              <prop k="line_style" v="solid"/>
            </layer>
          </symbol>
          <symbol alpha="0.9" clip_to_extent="1" force_rhr="0" name="sec_sym" type="line">
            <layer class="SimpleLine" locked="0" pass="1">
              <prop k="line_color" v="59,130,246,255"/>
              <prop k="line_width" v="0.9"/>
              <prop k="line_style" v="solid"/>
            </layer>
          </symbol>
          <symbol alpha="0.75" clip_to_extent="1" force_rhr="0" name="tert_sym" type="line">
            <layer class="SimpleLine" locked="0" pass="0">
              <prop k="line_color" v="100,116,139,200"/>
              <prop k="line_width" v="0.6"/>
              <prop k="line_style" v="solid"/>
            </layer>
          </symbol>
          <symbol alpha="0.5" clip_to_extent="1" force_rhr="0" name="res_sym" type="line">
            <layer class="SimpleLine" locked="0" pass="0">
              <prop k="line_color" v="71,85,105,150"/>
              <prop k="line_width" v="0.35"/>
              <prop k="line_style" v="solid"/>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- LAYER 3: Metropolitan Road Intersections (29,385 Nodes) -->
    <maplayer autoRefreshTime="0" hasScaleBasedVisibilityFlag="1" id="iers_metropolitan_nodes" maxScale="0" minScale="25000" refreshOnNotifyEnabled="0" type="vector">
      <id>iers_metropolitan_nodes</id>
      <datasource>dbname='iers_db' host=localhost port=5434 user='iers_user' password='iers_dev_local' sslmode=disable key='node_id' srid=4326 type=Point table="iers"."road_nodes" (location) sql=</datasource>
      <layername>3. Road Network Vertices (29,385 Nodes - PostGIS)</layername>
      <srs>
        <spatialrefsys><srid>4326</srid><authid>EPSG:4326</authid></spatialrefsys>
      </srs>
      <renderer-v2 type="singleSymbol">
        <symbols>
          <symbol alpha="0.6" clip_to_extent="1" force_rhr="0" name="0" type="marker">
            <layer class="SimpleMarker" locked="0" pass="0">
              <prop k="color" v="148,163,184,180"/>
              <prop k="size" v="1.2"/>
              <prop k="outline_color" v="15,23,42,200"/>
              <prop k="outline_width" v="0.2"/>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- LAYER 4: Metropolitan Hospitals & Trauma Hubs (Hubballi & Dharwad) -->
    <maplayer autoRefreshTime="0" hasScaleBasedVisibilityFlag="0" id="iers_hospitals_metro" maxScale="0" minScale="1e+08" refreshOnNotifyEnabled="0" type="vector">
      <id>iers_hospitals_metro</id>
      <datasource>dbname='iers_db' host=localhost port=5434 user='iers_user' password='iers_dev_local' sslmode=disable key='hospital_id' srid=4326 type=Point table="iers"."hospitals" (geom) sql=</datasource>
      <layername>4. Hospitals &amp; Trauma Hubs (Hubballi &amp; Dharwad - PostGIS)</layername>
      <srs>
        <spatialrefsys><srid>4326</srid><authid>EPSG:4326</authid></spatialrefsys>
      </srs>
      <renderer-v2 type="singleSymbol">
        <symbols>
          <symbol alpha="1" clip_to_extent="1" force_rhr="0" name="0" type="marker">
            <layer class="SimpleMarker" locked="0" pass="10">
              <prop k="color" v="239,68,68,255"/>
              <prop k="size" v="6.5"/>
              <prop k="name" v="cross"/>
              <prop k="outline_color" v="255,255,255,255"/>
              <prop k="outline_width" v="1.2"/>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- LAYER 5: Metropolitan Emergency Fleet (ALS/BLS Stations) -->
    <maplayer autoRefreshTime="0" hasScaleBasedVisibilityFlag="0" id="iers_ambulances_metro" maxScale="0" minScale="1e+08" refreshOnNotifyEnabled="0" type="vector">
      <id>iers_ambulances_metro</id>
      <datasource>dbname='iers_db' host=localhost port=5434 user='iers_user' password='iers_dev_local' sslmode=disable key='ambulance_id' srid=4326 type=Point table="iers"."ambulances" (geom) sql=</datasource>
      <layername>5. Emergency Fleet Units (Hubballi &amp; Dharwad - PostGIS)</layername>
      <srs>
        <spatialrefsys><srid>4326</srid><authid>EPSG:4326</authid></spatialrefsys>
      </srs>
      <renderer-v2 type="categorizedSymbol" attr="vehicle_type">
        <categories>
          <category value="ALS" label="Advanced Life Support (ALS)" symbol="als_sym"/>
          <category value="BLS" label="Basic Life Support (BLS)" symbol="bls_sym"/>
          <category value="FLYER" label="Rapid Response Flyer" symbol="flyer_sym"/>
        </categories>
        <symbols>
          <symbol alpha="1" clip_to_extent="1" force_rhr="0" name="als_sym" type="marker">
            <layer class="SimpleMarker" locked="0" pass="5">
              <prop k="color" v="245,158,11,255"/>
              <prop k="size" v="5.5"/>
              <prop k="name" v="square"/>
              <prop k="outline_color" v="255,255,255,255"/>
              <prop k="outline_width" v="1.0"/>
            </layer>
          </symbol>
          <symbol alpha="1" clip_to_extent="1" force_rhr="0" name="bls_sym" type="marker">
            <layer class="SimpleMarker" locked="0" pass="5">
              <prop k="color" v="59,130,246,255"/>
              <prop k="size" v="5.0"/>
              <prop k="name" v="circle"/>
              <prop k="outline_color" v="255,255,255,255"/>
              <prop k="outline_width" v="1.0"/>
            </layer>
          </symbol>
          <symbol alpha="1" clip_to_extent="1" force_rhr="0" name="flyer_sym" type="marker">
            <layer class="SimpleMarker" locked="0" pass="5">
              <prop k="color" v="16,185,129,255"/>
              <prop k="size" v="4.5"/>
              <prop k="name" v="triangle"/>
              <prop k="outline_color" v="255,255,255,255"/>
              <prop k="outline_width" v="1.0"/>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- LAYER 6: Campus Reference Dataset (Preserved in campus_reference schema) -->
    <maplayer autoRefreshTime="0" hasScaleBasedVisibilityFlag="1" id="campus_ref_roads" maxScale="0" minScale="50000" refreshOnNotifyEnabled="0" type="vector">
      <id>campus_ref_roads</id>
      <datasource>dbname='iers_db' host=localhost port=5434 user='iers_user' password='iers_dev_local' sslmode=disable key='edge_id' srid=4326 type=LineString table="campus_reference"."road_network_edges" (geom) sql=</datasource>
      <layername>6. Campus Micro-Navigation Reference (Preserved)</layername>
      <srs>
        <spatialrefsys><srid>4326</srid><authid>EPSG:4326</authid></spatialrefsys>
      </srs>
      <renderer-v2 type="singleSymbol">
        <symbols>
          <symbol alpha="0.7" clip_to_extent="1" force_rhr="0" name="0" type="line">
            <layer class="SimpleLine" locked="0" pass="0">
              <prop k="line_color" v="168,85,247,200"/>
              <prop k="line_width" v="0.8"/>
              <prop k="line_style" v="dot"/>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

  </projectlayers>
</qgis>